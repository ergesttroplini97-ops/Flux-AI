# Flux AI — variabili per /api/lead
# Copiare in .env.local per lo sviluppo (vercel dev) e inserirle su
# Vercel → Project → Settings → Environment Variables per la produzione.

# Origini autorizzate a fare POST sull'endpoint (CSRF di base)
ALLOWED_ORIGINS=https://www.flux-ai.it,https://flux-ai.it

# Notifica email del lead (obbligatoria) — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
LEAD_TO_EMAIL=ergest@flux-ai.it,daniel@flux-ai.it
LEAD_FROM_EMAIL=Flux AI <no-reply@flux-ai.it>

# Archivio lead su Supabase (facoltativo: senza queste, l'endpoint invia solo l'email)
# Creare il progetto in regione EU (eu-central-1) per non uscire dallo SEE.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...        # service_role — solo server, mai nel front-end

# Salt per l'HMAC dell'IP (pseudonimizzazione GDPR). Generare con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=cambiami-con-una-stringa-random-di-64-caratteri
